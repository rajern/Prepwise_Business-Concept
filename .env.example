# Kopiér til .env og erstatt verdiene lokalt. Ikke legg .env i Git.
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Used when FastAPI runs directly on the host. Docker Compose overrides the host with `db`.
DATABASE_URL=postgresql+psycopg://prepwise:change-me@localhost:5432/prepwise
POSTGRES_DB=prepwise
POSTGRES_USER=prepwise
POSTGRES_PASSWORD=change-me

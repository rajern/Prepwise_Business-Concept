# Kopiér til .env og erstatt verdiene lokalt. Ikke legg .env i Git.
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Public Entra External ID validation configuration; these values are not credentials.
ENTRA_TENANT_ID=1a782388-bf90-4ea8-af8f-bcc755f5cd7e
ENTRA_TENANT_SUBDOMAIN=prepwisecustomers
ENTRA_API_CLIENT_ID=82773ea0-fcf3-4874-81c3-3cd0da7d00c7
ENTRA_API_SCOPE=access_as_user
# Used when FastAPI runs directly on the host. Docker Compose overrides the host with `db`.
DATABASE_URL=postgresql+psycopg://prepwise:change-me@localhost:5432/prepwise
POSTGRES_DB=prepwise
POSTGRES_USER=prepwise
POSTGRES_PASSWORD=change-me
